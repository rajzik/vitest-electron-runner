{
  "name": "vitest-electron-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Run Vitest tests in real Electron main and renderer processes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajzik/vitest-electron-runner.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack && node scripts/copy-assets.mjs",
    "dev": "vp pack --watch",
    "test": "pnpm build && node --test --test-concurrency=1 test/*.test.mjs",
    "test:watch": "node --test --watch --test-concurrency=1 test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@ungap/structured-clone": "1.4.0"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "electron": ">=44.2.0 <45",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": "^22.15.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
